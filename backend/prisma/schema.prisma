// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // ok così come lo usi ora
}

enum TipoUtenza {
  GAS
  POWER
}

model Cliente {
  id        Int       @id @default(autoincrement())

  // campi esistenti
  nome      String
  cognome   String

  // reso opzionale per compatibilità import (spesso manca)
  email     String?   @unique

  // nuovi campi utili all’import insoluti (niente @db.VarChar)
  codiceFiscale         String?
  partitaIva            String?
  telefono              String?
  indirizzoFatturazione String?
  comune                String?

  utenze    Utenza[]
  fatture   Fattura[]
  pratiche  Pratica[]   // relazione già esistente

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([codiceFiscale])
  @@index([partitaIva])
}

model Utenza {
  id               Int       @id @default(autoincrement())
  clienteId        Int
  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  tipo             TipoUtenza
  codice           String    @unique          // PDR/POD/IdUtenza normalizzato
  stato            String?                    // Stato_Utenza
  descrizioneStato String?                    // DesStato_Utenza
  dataCessazione   DateTime?                  // Data_Cessazione
  comune           String?
  recapitoTelefono String?                    // RecapitoTelefonico
  agente           String?                    // Agente

  fatture          Fattura[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Fattura {
  id               Int       @id @default(autoincrement())
  clienteId        Int
  cliente          Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  utenzaId         Int?
  utenza           Utenza?   @relation(fields: [utenzaId], references: [id])

  numero           String
  dataFattura      DateTime?                 // DataFattura
  periodo          String?                   // Periodo Fatturazione

  // Importi come Decimal (senza @db.Decimal)
  importo          Decimal
  incassato        Decimal?

  scadenza         DateTime?                 // scadenza
  stato            String?                   // stato

  esclusaElab      Boolean    @default(false)    // EsclusioneContrattoDaElab.
  sollecitoData    DateTime?                 // Data primo sollecito ancora aperto
  sollecitoImporto Decimal?                  // Importo data primo sollecito
  pianoRientro     String?                   // Piano di rientro o rateizzazione
  praticaRef       String?                   // Pratica PDR/POD
  praticaData      DateTime?                 // Data pratica PDR/POD

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([clienteId, numero]) // decisione tecnica già presa
  @@index([numero])
  @@index([scadenza])
}

model Pratica {
  id          Int      @id @default(autoincrement())
  titolo      String
  descrizione String?
  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
}