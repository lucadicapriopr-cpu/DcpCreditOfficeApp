// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  cognome   String
  email     String   @unique
  createdAt DateTime @default(now())
  pratiche  Pratica[]
}

model Pratica {
  id        Int      @id @default(autoincrement())
  titolo    String
  stato     String   // es. "aperta", "chiusa", "in corso"
  clienteId Int
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  createdAt DateTime @default(now())
}
