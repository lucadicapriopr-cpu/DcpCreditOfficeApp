{
  "name": "dcp-credit-office-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "reset:db": "prisma migrate reset --force --skip-generate --skip-seed",
    "import": "node scripts/importInsoluti.cjs",
    "sync": "node scripts/importInsoluti.cjs",
    "server": "node backend/server.js",
    "server:dev": "nodemon --ext js,mjs,cjs --watch backend backend/server.js",
    "start": "npm run server"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.1.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "prisma": "^6.14.0",
    "vite": "^5.2.0"
  }
}
