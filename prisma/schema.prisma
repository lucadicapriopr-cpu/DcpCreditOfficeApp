generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Cliente {
  idCliente    Int       @id @default(autoincrement())
  nominativo   String
  codiceFiscale String?   @unique
  partitaIva   String?   @unique
  telefono     String?
  email        String?   @unique   // ← opzionale se serve
  utenze       Utenza[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Utenza {
  idUtenza        Int       @id @default(autoincrement())
  clienteId       Int
  contratto       String
  podPdr          String
  comune          String?
  stato           String?
  descrizioneStato String?
  dataCessazione  DateTime?

  cliente         Cliente   @relation(fields: [clienteId], references: [idCliente])
  fatture         Fattura[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([clienteId, contratto, podPdr], name: "clienteId_contratto_podPdr")
}

model Fattura {
  idFattura            Int       @id @default(autoincrement())
  utenzaId             Int
  numero               String
  dataFattura          DateTime?
  periodo              String?
  importo              Float
  scadenza             DateTime?
  stato                String
  incassato            Float?
  dataPrimoSollecito   DateTime?
  importoPrimoSollecito Float?
  pianoRientro         String?
  praticaPod           String?
  dataPraticaPod       DateTime?
  agente               String?
  esclusione           Boolean   @default(false)

  utenza               Utenza    @relation(fields: [utenzaId], references: [idUtenza])

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([utenzaId, numero], name: "utenzaId_numero") // evita doppie fatture uguali
}
